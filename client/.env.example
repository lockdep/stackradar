# Auth.js Configuration
# Generate AUTH_SECRET with: openssl rand -base64 32
AUTH_SECRET=your-secret-here

# Required in production. We self-host behind an ingress, so Auth.js cannot
# infer its own origin from the request and will throw `UntrustedHost` on every
# request without this. Auth.js trusts localhost automatically, so it is only
# needed in deployed environments — but /api/health/ready fails the pod if it is
# missing there, so the deploy must set it.
# Set AUTH_URL to the full public origin instead if you'd rather pin it exactly
# (e.g. AUTH_URL=https://app.stackradar.io).
AUTH_TRUST_HOST=true

# Local username/password sign-in (docs/open-source-plan-2026-10-10.md step 04).
# On by default in the community edition, off by default in the cloud
# (STACKRADAR_EDITION=cloud); "true"/"false" overrides either. On first start
# with no local account, the bootstrap admin below is created with
# must_change_password set, so the fixture password is used once — to replace
# itself. Locked out? `pnpm admin:reset-password <email>`.
# AUTH_LOCAL_ENABLED=true
# AUTH_BOOTSTRAP_ADMIN_EMAIL=admin@stackradar.local
# AUTH_BOOTSTRAP_ADMIN_PASSWORD=admin

# Generic OpenID Connect (Keycloak, Authentik, Entra ID, Okta, Zitadel).
# All three required for the provider to exist; discovery runs from the issuer.
# Callback URL: http://localhost:3000/api/auth/callback/oidc
# AUTH_OIDC_ISSUER=https://idp.example.com/realms/stackradar
# AUTH_OIDC_ID=stackradar
# AUTH_OIDC_SECRET=...
# AUTH_OIDC_NAME=Keycloak                 # button label; default "Single sign-on"
# AUTH_OIDC_SCOPE=openid email profile    # add e.g. "groups" if your IdP needs the scope
# AUTH_OIDC_ADMIN_GROUP=stackradar-admins # members of this group are platform admins, re-evaluated at every sign-in
# AUTH_OIDC_GROUPS_CLAIM=groups           # the claim that carries group membership

# GitHub OAuth
# Create at: https://github.com/settings/developers
# Callback URL: http://localhost:3000/api/auth/callback/github
AUTH_GITHUB_ID=your-github-client-id
AUTH_GITHUB_SECRET=your-github-client-secret

# Google OAuth (optional — leave unset to hide the Google button; a provider is enabled only when both its ID and SECRET are set)
# Create at: https://console.cloud.google.com/apis/credentials
# Callback URL: http://localhost:3000/api/auth/callback/google
AUTH_GOOGLE_ID=your-google-client-id
AUTH_GOOGLE_SECRET=your-google-client-secret

# Database — the SAME database as the server's. The Auth.js tables live in
# its `auth` schema (open-source plan step 05); one connection string for
# both apps. Give this app its own role in production if you want least
# privilege: it needs the `auth` schema only.
DATABASE_URL=postgresql://postgres:postgres@localhost:5444/server

# Migrations on boot (self-hosted installs; the cloud leaves these unset and
# runs a deploy Job). MIGRATE_ON_START=true applies this app's Drizzle chain
# before `next start`, under the same advisory lock the server migrates
# under, so replicas of either app serialise. MIGRATE_EXIT_AFTER=true
# applies it and exits 0 — the same image as a one-shot initializer Job.
# MIGRATE_ON_START=true
# MIGRATE_EXIT_AFTER=true

# Express backend
EXPRESS_API_URL=http://localhost:8080
# Shared secret sent to Express as X-Internal-Key; must match the server's value
INTERNAL_SERVICE_KEY=your-internal-service-key

# PostHog product analytics (EU cloud). Read at runtime by the root layout and
# passed to the browser — deliberately not NEXT_PUBLIC_, so one image serves
# every environment. Leave unset locally to disable analytics; deployed
# environments get their key from the client-config ConfigMap in
# stackradar-gitops (dev and prod use different PostHog projects).
# POSTHOG_KEY=phc_...

# Scanner Helm chart version shown in the "Connect cluster" install command.
# Read at runtime (not NEXT_PUBLIC_) so one image serves every environment;
# deployed environments set it in the client-config ConfigMap in
# stackradar-gitops, bumped when a new stackradar-scanner chart is released.
# Leave unset locally to show a <version> placeholder.
# SCANNER_CHART_VERSION=0.4.2

# The live demo (docs/live-demo/ step 02). Set ONLY on the demo Deployment:
# `GET /demo/enter` then signs anyone in as the demo user for two hours,
# /login redirects there, a banner shows, and every control the server would
# refuse (403 read_only_demo) is left undrawn. Unset = production; anything
# but the literal "true" is unset. The demo user must exist in the client
# `users` table with `demo = true` (step 05 seeds it), or /demo/enter 500s.
# DEMO_MODE=true
# DEMO_USER_EMAIL=demo@stackradar.io

# Chart Index tab in the admin dashboard: the charts site's key-gated status
# read (charts/src/app/internal/status/route.ts). URL = the charts site
# (locally `pnpm dev` in charts/ on 3002; deployed, the in-cluster Service in
# the client-config ConfigMap); KEY must equal STATUS_SERVICE_KEY in charts/.env
# (deployed: client-secrets). Leave both unset to show the tab as unconfigured.
# CHARTS_STATUS_URL=http://localhost:3002
# CHARTS_STATUS_KEY=dev
