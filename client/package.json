{
  "name": "client",
  "version": "0.2.0-snapshot",
  "private": true,
  "description": "StackRadar web UI and BFF (Next.js) in front of the API server",
  "license": "AGPL-3.0-only",
  "homepage": "https://github.com/lockdep/stackradar#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lockdep/stackradar.git",
    "directory": "client"
  },
  "bugs": {
    "url": "https://github.com/lockdep/stackradar/issues"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@11.1.2",
  "scripts": {
    "dev": "next dev",
    "dev:pretty": "next dev 2>&1 | pino-pretty",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "tokens:check": "node scripts/sync-primer-tokens.mjs",
    "tokens:sync": "node scripts/sync-primer-tokens.mjs --write",
    "tokens:find": "node scripts/sync-primer-tokens.mjs --find",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:migrate:boot": "node scripts/migrate.mjs",
    "db:studio": "drizzle-kit studio",
    "db:up": "cd .. && docker compose up -d",
    "db:down": "cd .. && docker compose down",
    "db:reset": "../scripts/reset-db.sh",
    "knip": "knip",
    "admin:reset-password": "node scripts/admin-reset-password.mjs",
    "test": "vitest run"
  },
  "dependencies": {
    "@auth/drizzle-adapter": "^1.11.3",
    "@headlessui/react": "^2.2.10",
    "@node-rs/argon2": "2.2.1",
    "drizzle-kit": "^0.31.8",
    "drizzle-orm": "^0.45.2",
    "lucide-react": "^0.577.0",
    "next": "16.3.8",
    "next-auth": "5.0.0-beta.32",
    "pino": "^10.4.0",
    "postgres": "^3.4.7",
    "posthog-js": "^1.415.1",
    "react": "19.2.1",
    "react-dom": "19.2.1",
    "react-icons": "^5.5.0",
    "recharts": "^3.8.0"
  },
  "devDependencies": {
    "@primer/primitives": "^11.9.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "knip": "^6.32.2",
    "pino-pretty": "^13.1.3",
    "prettier": "3.8.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.11"
  }
}
