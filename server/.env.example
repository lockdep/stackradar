# StackRadar server — local development defaults.
#
#   cp .env.example .env
#
# Values here match the root docker-compose.yml Postgres (port 5444) and the
# client's .env.example, so the two apps talk to each other out of the box.
# Every variable the server reads is listed here, with its default where one
# exists: the first sections are what an install sets, the tuning sections
# are knobs nobody needs on day one, and the last section is the cloud
# edition's. The ones a self-hosted install sets are also in
# deploy/compose/docker-compose.yml.

# ---- Required -----------------------------------------------------------------

# The one database both apps share: the server owns `public`, the client the
# `auth` schema. The URL must carry an explicit sslmode (`prefer` is fine
# locally; a production URL weaker than `require` is refused).
DATABASE_URL=postgresql://postgres:postgres@localhost:5444/server?sslmode=prefer

# Shared secret on every BFF → server call (X-Internal-Key). Any string, the
# same value in the client's .env.local.
INTERNAL_SERVICE_KEY=dev-internal-service-key

# Encrypts scanner API keys at rest so an admin can reveal them. 64 hex
# characters (`openssl rand -hex 32`). Changing it later makes the stored keys
# unreadable, so set it once.
API_KEY_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# ---- Edition and topology -------------------------------------------------------

# `community` (the default when unset) or `cloud`.
STACKRADAR_EDITION=community

# `monolith` runs the job worker and the sync crons inside the API process;
# `split` expects a separate worker (`pnpm worker`) and external CronJobs.
# Unset follows the edition (community → monolith).
# TOPOLOGY=monolith

# Apply the Drizzle migration chain before listening. Only ever against a
# database you own. MIGRATE_EXIT_AFTER=true migrates and exits 0 instead
# (a one-shot initializer).
MIGRATE_ON_START=true
# MIGRATE_EXIT_AFTER=true

# ---- The install's own cluster (community) --------------------------------------

# Seeded at start-up: the cluster the dashboard shows and the scanner key that
# uploads to it. Any UUID and any secret string; the scanner's Helm values
# carry the same key.
BOOTSTRAP_CLUSTER_ID=8f6b0b7a-0c1e-4f6e-9a4b-2f3d1c0e5a71
BOOTSTRAP_CLUSTER_API_KEY=dev-bootstrap-scanner-key

# ---- URLs ---------------------------------------------------------------------

PORT=8080
# Where the client is reachable from a browser; links in alerts point here.
APP_URL=http://localhost:3000
# The browser-reachable API host, used in install commands and unsubscribe
# links. Unset, it falls back to localhost:8080.
# PUBLIC_API_URL=http://localhost:8080

# ---- Vulnerability data -----------------------------------------------------------

# OSV directories the mirror carries (case-sensitive, comma-separated). Unset
# = the community default list; `*` = everything. `Alpine` alone bootstraps in
# about two minutes and is enough for the nginx fixture under tests/fixtures.
# OSV_ECOSYSTEMS=Alpine,Debian,Ubuntu,npm

# The nightly Artifact Hub mirror behind chart upgrade suggestions.
# ARTIFACT_HUB_SYNC_ENABLED=true

# Days an image with no running container keeps its SBOM and findings.
# IMAGE_GC_RETENTION_DAYS=30

# ---- Operations -------------------------------------------------------------------

# pino level: trace | debug | info | warn | error
LOG_LEVEL=info
# PEM bundle for a Postgres that presents a private CA (managed databases).
# DATABASE_CA_CERT=
# Oldest scanner version the API accepts, e.g. 0.2.0. Unset = any.
# SCANNER_MIN_VERSION=
# A free-text notice every agent logs on heartbeat (a maintenance window).
# SCANNER_FLEET_MESSAGE=
# `production` turns on JSON logs and the TLS rule on DATABASE_URL.
# NODE_ENV=development
# Appended to the reported server version (`0.1.0+abc1234`); the image build sets it.
# GIT_SHA=
# The public chart index, as a source of measured chart-upgrade deltas. Both
# unset (the default) and an unmeasured chart bump stays unmeasured.
# CHART_INDEX_URL=
# CHART_INDEX_DELTA_KEY=
# Key for POST /internal/match (docs/contracts/match-endpoint.md). Unset = the
# endpoint is not mounted. The two limits bound one request's component list
# and one key's candidate rows.
# MATCH_SERVICE_KEY=
# MATCH_MAX_COMPONENTS=20000
# MATCH_MAX_CANDIDATES_PER_KEY=20000
# Server-side product analytics (funnel events the browser cannot see).
# Empty = events are logged and skipped. Public project token, not a secret.
# POSTHOG_API_KEY=
# POSTHOG_HOST=https://eu.i.posthog.com

# ---- Database tuning --------------------------------------------------------------

# Connections in this process's pool; the API and the worker each get one.
# DB_POOL_MAX=10
# DB_CONNECT_TIMEOUT_SECONDS=10
# Session statement_timeout and idle_in_transaction_session_timeout.
# DB_STATEMENT_TIMEOUT_MS=120000
# DB_IDLE_IN_TRANSACTION_TIMEOUT_MS=60000
# Per-session planner settings (see src/config/index.ts for why).
# DB_JIT=off
# DB_WORK_MEM=32MB

# ---- Schedules (monolith topology; cron syntax) -------------------------------------

# The in-process crons. A split-topology deployment runs the sync CLIs from
# its own CronJobs and these are unused there. Minutes are staggered on
# purpose: EPSS, KEV and the OSV sync all UPDATE `vulnerabilities`.
# OSV_SYNC_CRON=0 * * * *
# OSV_BOOTSTRAP_CRON=0 */12 * * *
# EPSS_SYNC_CRON=15 6 * * *
# KEV_SYNC_CRON=15 7 * * *
# ARTIFACT_HUB_SYNC_CRON=15 2 * * *
# The job worker's own crons (src/jobs/job-worker.ts).
# CLEANUP_CRON=0 * * * *
# METRICS_CRON=0 * * * *
# IMAGE_GC_CRON=30 3 * * *
# CHART_REPO_SYNC_CRON=45 4 * * *
# CHART_RENDER_CRON=15 5 * * *
# IMAGE_LAYER_BACKFILL_CRON=50 5 * * *
# ALERT_CRON=*/5 * * * *
# DIGEST_CRON=5 7 * * 1

# ---- Job worker tuning ---------------------------------------------------------------

# JOB_POLL_INTERVAL_MS=5000
# JOB_BATCH_SIZE=5
# JOB_STALE_TIMEOUT_MS=1800000
# JOB_STALE_CHECK_INTERVAL_MS=60000
# Images one GC sweep deletes; layer lists one backfill run fetches.
# IMAGE_GC_BATCH_LIMIT=500
# IMAGE_LAYER_BACKFILL_LIMIT=50
# Alert batching: send after a quiet period, never later than the max delay.
# ALERT_QUIET_MINUTES=10
# ALERT_MAX_DELAY_MINUTES=60
# Base-image resolution and base-upgrade checks per run (registry calls).
# BASE_RERESOLVE_LIMIT=500
# BASE_REGISTRY_BUDGET=40
# BASE_CHECK_LIMIT=30
# Byte ceiling on a chart repository's index.yaml.
# CHART_REPO_MAX_INDEX_BYTES=5242880

# ---- Feed tuning (src/<feed>/config.ts; the defaults are the shipped ones) ----------

# OSV_STORAGE_BASE_URL=https://storage.googleapis.com/osv-vulnerabilities
# OSV_ALL_ZIP_URL=https://storage.googleapis.com/osv-vulnerabilities/all.zip
# OSV_MODIFIED_CSV_URL=https://storage.googleapis.com/osv-vulnerabilities/modified_id.csv
# OSV_USER_AGENT=stackradar-osv-sync/<version>
# OSV_BATCH_SIZE=100
# OSV_MAX_RETRIES=3
# OSV_RETRY_BASE_DELAY_MS=1000
# OSV_REQUEST_TIMEOUT_MS=30000
# OSV_STREAM_STALL_TIMEOUT_MS=60000
# OSV_MAX_PARALLEL_DOWNLOADS=8
# OSV_OVERLAP_WINDOW_MINUTES=10
# OSV_BULK_FALLBACK_THRESHOLD=5000
# OSV_LAG_WARNING_THRESHOLD_HOURS=6
# OSV_FAILURE_RETENTION_DAYS=30
# OSV_BOOTSTRAP_MAX_FAILED_ENTRIES=1000
# OSV_BOOTSTRAP_MAX_FAILED_ENTRY_RATIO=0.005
# OSV_ADVISORY_LOCK_ID=8675309
# EPSS_FEED_URL=https://epss.empiricalsecurity.com/epss_scores-current.csv.gz
# EPSS_USER_AGENT=stackradar-epss-sync/<version>
# EPSS_MAX_RETRIES=3
# EPSS_RETRY_BASE_DELAY_MS=2000
# EPSS_REQUEST_TIMEOUT_MS=60000
# EPSS_STAGING_BATCH_SIZE=5000
# EPSS_MIN_ROWS_TO_APPLY=150000
# EPSS_MIN_SYNC_INTERVAL_HOURS=23
# KEV_FEED_URL=https://www.cisa.gov/sites/default/files/feeds/known_exploited_vulnerabilities.json
# KEV_USER_AGENT=stackradar-kev-sync/<version>
# KEV_MAX_RETRIES=3
# KEV_RETRY_BASE_DELAY_MS=2000
# KEV_REQUEST_TIMEOUT_MS=30000
# KEV_MIN_ENTRIES_TO_APPLY=500
# KEV_MIN_SYNC_INTERVAL_HOURS=23
# ARTIFACT_HUB_FEED_URL=https://artifacthub.io/api/v1/nova
# ARTIFACT_HUB_USER_AGENT=stackradar-artifacthub-sync/<version>
# ARTIFACT_HUB_MAX_BODY_BYTES=104857600
# ARTIFACT_HUB_MAX_RETRIES=3
# ARTIFACT_HUB_RETRY_BASE_DELAY_MS=2000
# ARTIFACT_HUB_REQUEST_TIMEOUT_MS=120000
# ARTIFACT_HUB_STAGING_BATCH_SIZE=500
# ARTIFACT_HUB_MIN_PACKAGES_TO_APPLY=10000
# ARTIFACT_HUB_MIN_SYNC_INTERVAL_HOURS=23
# ARTIFACT_HUB_ADVISORY_LOCK_ID=8675310

# ---- Chart render and platform scan (src/chart-render, src/platform-scan) ------------

# The binaries the worker shells out to, and the ceilings on what one run
# downloads, renders and scans.
# HELM_BIN=helm
# SYFT_BIN=syft
# CHART_RENDER_MAX_PER_RUN=25
# CHART_RENDER_MAX_TARBALL_BYTES=20971520
# CHART_RENDER_MAX_OUTPUT_BYTES=52428800
# CHART_RENDER_REQUEST_TIMEOUT_MS=60000
# CHART_RENDER_TIMEOUT_MS=60000
# PLATFORM_SCAN_PLATFORM=linux/amd64
# PLATFORM_SCAN_MAX_PER_SWEEP=50
# PLATFORM_SCAN_MAX_IMAGE_BYTES=1073741824
# PLATFORM_SCAN_MAX_SBOM_BYTES=52428800
# PLATFORM_SCAN_MANIFEST_TIMEOUT_MS=30000
# PLATFORM_SCAN_TIMEOUT_MS=600000

# ---- Cloud edition only -----------------------------------------------------------------

# Read in both editions (readiness reports what is missing) and used only by
# src/cloud. A self-hosted install leaves every one of these unset.
# Billing (Stripe); prices resolve by lookup key, there are no price ids.
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# Transactional email over Resend. Empty = invites, digests and alert mail are
# logged, not sent; the admin shares the invite link by hand.
# RESEND_API_KEY=
# RESEND_WEBHOOK_SECRET=
# EMAIL_FROM=StackRadar <no-reply@mail.stackradar.io>
# EMAIL_REPLY_TO=
# HMAC key for the unsubscribe links in mail; falls back to INTERNAL_SERVICE_KEY.
# DIGEST_UNSUBSCRIBE_SECRET=
# The marketing site; emails link to its docs.
# SITE_URL=https://stackradar.io
# Reddit Ads conversions. Both empty = conversions are logged and skipped.
# REDDIT_PIXEL_ID=
# REDDIT_CONVERSIONS_TOKEN=
# REDDIT_CONVERSIONS_API_URL=https://ads-api.reddit.com/api/v3/pixels
# REDDIT_CONVERSIONS_TEST_ID=
# Founder alerts on sign-up and first cluster. Either alone is enough.
# FOUNDER_ALERT_EMAIL=
# FOUNDER_ALERT_SLACK_WEBHOOK_URL=
