{
  "name": "server",
  "version": "1.0.0",
  "description": "",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/src/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:ci": "vitest run --reporter=junit --outputFile=test-results.xml",
    "db:generate": "tsx node_modules/drizzle-kit/bin.cjs generate",
    "db:migrate": "tsx node_modules/drizzle-kit/bin.cjs migrate",
    "db:studio": "tsx node_modules/drizzle-kit/bin.cjs studio",
    "db:up": "cd .. && docker compose up -d",
    "db:down": "cd .. && docker compose down",
    "db:logs": "cd .. && docker compose logs -f postgres",
    "db:reset": "../scripts/reset-db.sh",
    "osv-sync": "tsx src/osv-sync/cli.ts",
    "epss-sync": "tsx src/epss-sync/cli.ts",
    "kev-sync": "tsx src/kev-sync/cli.ts",
    "artifacthub-sync": "tsx src/artifacthub-sync/cli.ts",
    "seed-demo": "tsx src/cloud/demo/seed-demo.ts",
    "backfill:release-version": "tsx src/scripts/backfill-release-version.ts",
    "backfill:component-tier": "tsx src/scripts/backfill-component-tier.ts",
    "backfill:image-control": "tsx src/scripts/backfill-image-control.ts",
    "osv-schema:check": "node scripts/sync-osv-schema.mjs",
    "osv-schema:sync": "node scripts/sync-osv-schema.mjs --write",
    "osv-schema:verify": "node scripts/sync-osv-schema.mjs --verify",
    "worker": "tsx src/worker.ts",
    "worker:once": "tsx src/worker.ts --once",
    "knip": "knip"
  },
  "keywords": [],
  "author": "",
  "license": "AGPL-3.0-only",
  "packageManager": "pnpm@10.24.0",
  "dependencies": {
    "@cyclonedx/cyclonedx-library": "^9.4.1",
    "ae-cvss-calculator": "^1.0.13",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "croner": "^10.0.1",
    "dotenv": "^17.2.3",
    "drizzle-kit": "^0.31.8",
    "drizzle-orm": "^0.45.2",
    "express": "^5.2.1",
    "packageurl-js": "^2.0.1",
    "pino": "^10.1.0",
    "pino-http": "^11.0.0",
    "postgres": "^3.4.7",
    "prom-client": "^15.1.3",
    "semver": "^7.7.4",
    "stripe": "^22.1.1",
    "yaml": "^2.9.0",
    "yauzl": "^3.4.0",
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "@testcontainers/postgresql": "^10.18.0",
    "@types/express": "^5.0.6",
    "@types/node": "^25.0.1",
    "@types/semver": "^7.7.1",
    "@types/supertest": "^6.0.2",
    "@types/yauzl": "^2.10.3",
    "@vitest/coverage-v8": "3.2.4",
    "knip": "^6.32.2",
    "pino-pretty": "^13.1.3",
    "supertest": "^7.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.9.3",
    "vitest": "^3.0.0"
  },
  "pnpm": {
    "overrides": {
      "qs": ">=6.15.3",
      "body-parser": ">=2.3.0",
      "path-to-regexp": ">=8.4.2"
    }
  }
}
