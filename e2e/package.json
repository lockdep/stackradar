{
  "name": "e2e",
  "version": "0.0.0",
  "private": true,
  "description": "Playwright end-to-end tests over the Compose quickstart built from this checkout",
  "license": "AGPL-3.0-only",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@11.1.2",
  "scripts": {
    "test": "playwright test",
    "test:ui": "playwright test --ui",
    "test:headed": "playwright test --headed",
    "report": "playwright show-report",
    "stack:up": "scripts/stack.sh up",
    "stack:down": "scripts/stack.sh down",
    "stack:logs": "scripts/stack.sh logs",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "^22",
    "prettier": "3.8.1",
    "typescript": "^5"
  }
}
